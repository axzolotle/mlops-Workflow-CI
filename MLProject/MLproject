name: fraud-detection-ci

conda_env: conda.yaml

parameters:
  data_path: {type: string}
  random_state: {type: int}
  n_estimators: {type: int}
  max_depth: {type: int}

entry_points:
  main:
    command: >
      python modelling.py
      --data_path {data_path}
      --random_state {random_state}
      --n_estimators {n_estimators}
      --max_depth {max_depth}
