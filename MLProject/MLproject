name: fraud-detection-ci

conda_env: conda.yaml


entry_points:
  main:
    parameters:
      random_state: {type: int, default: 42}
      n_estimators: {type: int, default: 100}
      max_depth: {type: int, default: 23}
      data_path: {type: str, default: "data_clean.csv"}
    command: >
      python modelling.py 
      --random_state {random_state} 
      --n_estimators {n_estimators} 
      --max_depth {max_depth} 
      --data_path {data_path}